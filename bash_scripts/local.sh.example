# Copy to local.sh (gitignored) and edit. Everything here is optional.

# Scheduler account, if your site requires one:
# FIRE_ACCOUNT=def-yourpi

# W&B logging. The cluster profile picks a default (offline on Alliance
# clusters, whose compute nodes have no internet; online elsewhere). Set it
# here if your site differs, e.g. a cluster whose nodes can reach wandb.ai:
# FIRE_WANDB_MODE=online          # offline | online | disabled

# Where generated data lives. Defaults to $SCRATCH/fire, or <repo>/.work.
# FIRE_WORK=/fast/scratch/$USER/fire

# Override the modules your cluster needs:
# FIRE_MODULES="StdEnv/2023 python/3.11.5 scipy-stack/2026a arrow/24.0.0 cuda/12.6"
